ARCHS = arm64
ALWAYS_SEARCH_USER_PATHS = NO
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
PRODUCT_BUNDLE_IDENTIFIER = local.arenasuite.app
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_CFBundleDisplayName = Arena Suite
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1

// Optional, git-ignored local signing (stable identity keeps Keychain access across rebuilds).
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
#include? "Signing.local.xcconfig"
